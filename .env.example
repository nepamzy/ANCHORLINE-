# Contact form email delivery (see docs/08-contact-functionality.md)
# Provider: Brevo (https://www.brevo.com) — client's chosen provider,
# simple HTTP API, no extra npm dependency. Not yet configured with
# real client credentials.

# API key from the Brevo dashboard (Settings > SMTP & API > API Keys).
# Without this set, the contact form validates and rate-limits
# normally but returns a clear "not configured" error instead of
# silently failing.
BREVO_API_KEY=

# Verified sender address in Brevo (requires a verified domain/sender).
CONTACT_FROM_EMAIL=

# Optional override of the destination inbox. Defaults to whatever is
# set as the contact email in the dashboard (Contact Information
# section) if unset — only set this for testing against a different
# inbox.
CONTACT_TO_EMAIL=

# --- Client dashboard / CMS ---

# Production site URL — used in sitemap.xml, robots.txt, canonical/OG
# tags, and structured data. Falls back to http://localhost:3000 in
# development.
NEXT_PUBLIC_SITE_URL=

# Client login credentials. Generate CLIENT_PASSWORD_HASH with:
#   node scripts/hash-password.mjs "the real password"
# Never store a plaintext password here or anywhere else.
CLIENT_USERNAME=
CLIENT_PASSWORD_HASH=

# Signing key for dashboard session cookies. Generate with e.g.:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Content database (Cloudflare D1) ---
# Backs the dashboard's draft/publish content store (src/lib/db.ts).
# Chosen over the project's earlier node:sqlite design because
# Vercel's serverless functions don't provide a persistent writable
# filesystem, an on-disk SQLite file wouldn't reliably survive
# between invocations there. D1 is queried over Cloudflare's plain
# HTTPS API (no npm driver needed), authenticated with a scoped API
# token, get all three values from the Cloudflare dashboard.
#
# CLOUDFLARE_ACCOUNT_ID: dashboard right sidebar on any account page,
# or the URL itself (dash.cloudflare.com/<this-is-it>/...).
CLOUDFLARE_ACCOUNT_ID=
#
# CLOUDFLARE_D1_DATABASE_ID: Workers & Pages -> D1 -> the anchorline-cms
# database -> its UUID is shown on the database's overview page.
CLOUDFLARE_D1_DATABASE_ID=
#
# CLOUDFLARE_API_TOKEN: My Profile -> API Tokens -> Create Token ->
# custom token scoped to D1:Edit for this account only (not the broad
# Edit Cloudflare Workers template). Never expose to the browser or
# commit to git.
CLOUDFLARE_API_TOKEN=

# --- Uploaded files (Cloudflare R2) ---
# Backs the dashboard's image/video upload feature (src/lib/r2.ts,
# src/app/api/dashboard/upload/route.ts, .../upload/blob-token/route.ts).
# Same reasoning as the database above: uploads can't be written to the
# local filesystem on Vercel.
#
# CLOUDFLARE_R2_ACCESS_KEY_ID / CLOUDFLARE_R2_SECRET_ACCESS_KEY:
# R2 -> Manage R2 API Tokens -> Create API Token -> permissions
# "Object Read & Write", scoped to just the anchorline-uploads bucket.
# This generates an Access Key ID + Secret Access Key pair (S3-
# compatible credentials, not the same as the CLOUDFLARE_API_TOKEN
# above, which only has D1 access).
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
#
# CLOUDFLARE_R2_BUCKET: the bucket name (already created: anchorline-uploads).
CLOUDFLARE_R2_BUCKET=anchorline-uploads
#
# CLOUDFLARE_R2_PUBLIC_URL: the base URL uploaded files are served from,
# no trailing slash. Either the bucket's r2.dev public URL (R2 ->
# anchorline-uploads -> Settings -> Public access -> enable "R2.dev
# subdomain", it'll show you the exact https://pub-xxxxx.r2.dev URL to
# use) or a custom domain connected to the bucket.
CLOUDFLARE_R2_PUBLIC_URL=

# --- Analytics (dashboard's Analytics page, src/lib/vercel-analytics.ts) ---
# Reads the real visitor/pageview data already being collected by
# @vercel/analytics/next (wired into src/app/layout.tsx) back out via
# Vercel's Web Analytics REST API, so it can show on the client's
# /dashboard/analytics page instead of only in the Vercel dashboard.
#
# VERCEL_API_TOKEN: vercel.com/account/tokens -> Create Token. A
# full-account token works; scope isn't limited to one project, so
# treat it like any other secret. Never expose to the browser or
# commit to git.
VERCEL_API_TOKEN=
#
# VERCEL_PROJECT_ID / VERCEL_TEAM_ID: not secret, identify the
# anchorline- project itself. Already defaulted in code to the real
# values, only set these if the project is ever moved/renamed.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
