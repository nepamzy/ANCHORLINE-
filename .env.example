# Contact form email delivery (see docs/08-contact-functionality.md)
# Provider: Brevo (https://www.brevo.com) — client's chosen provider,
# simple HTTP API, no extra npm dependency. Not yet configured with
# real client credentials.

# API key from the Brevo dashboard (Settings > SMTP & API > API Keys).
# Without this set, the contact form validates and rate-limits
# normally but returns a clear "not configured" error instead of
# silently failing.
BREVO_API_KEY=

# Verified sender address in Brevo (requires a verified domain/sender).
CONTACT_FROM_EMAIL=

# Optional override of the destination inbox. Defaults to whatever is
# set as the contact email in the dashboard (Contact Information
# section) if unset — only set this for testing against a different
# inbox.
CONTACT_TO_EMAIL=

# --- Client dashboard / CMS ---

# Production site URL — used in sitemap.xml, robots.txt, canonical/OG
# tags, and structured data. Falls back to http://localhost:3000 in
# development.
NEXT_PUBLIC_SITE_URL=

# Client login credentials. Generate CLIENT_PASSWORD_HASH with:
#   node scripts/hash-password.mjs "the real password"
# Never store a plaintext password here or anywhere else.
CLIENT_USERNAME=
CLIENT_PASSWORD_HASH=

# Signing key for dashboard session cookies. Generate with e.g.:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Content database (Supabase Postgres) ---
# Backs the dashboard's draft/publish content store (src/lib/db.ts).
# Chosen over the project's earlier node:sqlite design because
# Vercel's serverless functions don't provide a persistent writable
# filesystem — an on-disk SQLite file wouldn't reliably survive
# between invocations there. Get both values from the Supabase
# dashboard: Project Settings -> API.
#
# SUPABASE_URL is the "Project URL" shown there (safe to be public,
# but kept server-side here since it's only ever read by server code).
SUPABASE_URL=
#
# SUPABASE_SERVICE_ROLE_KEY is the secret "service_role" key on that
# same page (NOT the "anon"/"publishable" key). It bypasses Row Level
# Security by design — content_sections has RLS enabled with zero
# policies, so this key is required for the app to read/write it at
# all, and must never be exposed to the browser or committed to git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Uploaded files (Vercel Blob) ---
# Backs the dashboard's image/report upload feature (src/app/api/
# dashboard/upload/route.ts). Same reasoning as above: uploads can't
# be written to the local filesystem on Vercel. Auto-populated when a
# Blob store is created and attached to the Vercel project (Storage
# tab in the Vercel dashboard) — you generally won't type this one in
# by hand, Vercel injects it for you on deploy.
BLOB_READ_WRITE_TOKEN=
